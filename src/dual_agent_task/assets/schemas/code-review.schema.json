{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "verification_assessment"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approved", "changes_requested", "needs_user_input"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "path", "line", "issue", "expected_fix"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["blocking", "non_blocking"]
          },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "expected_fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification_assessment": {
      "type": "string",
      "minLength": 1
    }
  }
}

