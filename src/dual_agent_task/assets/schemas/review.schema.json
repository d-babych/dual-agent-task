{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "blocking", "suggestions"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approved", "changes_requested", "needs_user_input"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section", "issue", "expected_fix"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "expected_fix": { "type": "string", "minLength": 1 }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

